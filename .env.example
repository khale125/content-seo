# Bien moi truong cho may chu. Sao file nay thanh .env roi dien gia tri.
#   cp .env.example .env && chmod 600 .env
# .env da nam trong .gitignore. KHONG BAO GIO commit file .env.
# Huong dan day du: docs/15-trien-khai-vps.md

# --- WordPress (bat buoc de tao ban nhap) ---
# Tao tai: WP Admin -> Users -> Profile -> Application Passwords
# Day KHONG phai mat khau dang nhap. No bo qua xac thuc hai lop va thu hoi doc lap.
MBWP_USER=
MBWP_APP_PASSWORD=

# Tuy chon: doi site dich. Mac dinh la https://muaban.net/blog
# MBWP_SITE=https://muaban.net/blog

# --- Lark (chi can khi tu do khong ra) ---
# LARK_NODE=/usr/bin/node
# LARK_CLI_ENTRY=/usr/lib/node_modules/@larksuite/cli/scripts/run.js

# --- Locale (bat buoc tren Linux, neu chua dat trong ~/.bashrc) ---
LANG=C.UTF-8
PYTHONIOENCODING=utf-8
