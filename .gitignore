# Bi mat - KHONG BAO GIO commit
.env
.env.*
!.env.example
.muaban-wp.json
*.pem
*.key

# Goi ban giao va ban luu
*.zip
*.tar.gz
logs/

# LUU Y ve hai file KHONG nam trong danh sach nay:
#
#   work/<slug>/.lark.json   buoc thu muc voi dung ban ghi tren Lark Base
#   work/<slug>/.wp.json     buoc bai voi dung ban nhap tren WordPress
#
# Ca hai DUOC commit co chu y, vi day la repo dung chung cua mot team chia se
# mot Base. Thieu .lark.json thi dong nghiep clone repo ve khong push/pull/gate
# duoc bai da co; thieu .wp.json thi lan chay sau tao mot ban nhap TRUNG thay vi
# cap nhat ban nhap cu.
#
# Doi lai: hai nguoi cung sua mot bai se cham nhau o `content_version` va
# `content_hash`. Khi git bao conflict o .lark.json, lay ban co content_version
# CAO HON roi chay lai `lark_sync.py push work/<slug>`.

# Anh goc truoc khi cat 800x600 — tai lai duoc tu nguon
work/*/images/_goc/
